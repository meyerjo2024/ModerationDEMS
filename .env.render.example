# Paste into Render → your service → Environment → "Add from .env".
# Replace every value marked CHANGE-ME. Never commit the real file.

APP_NAME="Moderation DEMS"
APP_ENV=production
APP_DEBUG=false
# CHANGE-ME: generate with:  echo "base64:$(openssl rand -base64 32)"
APP_KEY=base64:CHANGE-ME
# CHANGE-ME: your Render URL
APP_URL=https://CHANGE-ME.onrender.com

PORT=8080
LOG_CHANNEL=stderr

# CHANGE-ME: Supabase → Connect → "Session pooler" (port 5432), with your real database password
DB_CONNECTION=pgsql
DB_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_LIFETIME=480
CACHE_STORE=file
QUEUE_CONNECTION=sync

# First login (HOD) + demo accounts (all share this password; 10+ characters)
DEMS_SEED_EMAIL=hod@example.edu
DEMS_SEED_NAME=Head of Department
DEMS_SEED_PASSWORD=CHANGE-ME-10-chars-min
DEMS_DEMO_DATA=true

INSTITUTION_NAME=CHANGE-ME

# E-mail not configured yet: reports are archived and downloadable in the app
MAIL_MAILER=log
