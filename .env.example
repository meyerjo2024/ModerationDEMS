APP_NAME="Moderation DEMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://moderation-dems.test

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ── Database ──────────────────────────────────────────────────────────────────
# Local (Laravel Herd Pro Postgres):
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=dems
DB_USERNAME=root
DB_PASSWORD=
# Supabase: comment the five lines above and set ONE connection string instead
# (Project Settings → Database → Connection string → "Session pooler", port 5432, works over IPv4;
#  URL-encode special characters in the password). Add DB_SSLMODE=require.
# DB_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
# DB_SSLMODE=require
# Only if you use the Supabase *transaction* pooler (port 6543):
# DB_EMULATE_PREPARES=true

SESSION_DRIVER=database
SESSION_LIFETIME=480
CACHE_STORE=file
QUEUE_CONNECTION=sync

# ── First-run admin (Head of Department), created by `php artisan db:seed` ────
DEMS_SEED_EMAIL=hod@example.edu
DEMS_SEED_NAME="Head of Department"
DEMS_SEED_PASSWORD=
# Staff self-registration: comma-separated e-mail domains allowed to register (empty = any). The HOD approves every registration.
DEMS_REGISTER_DOMAINS=
# Set to true for ONE deploy to delete the sample accounts/subjects from earlier test deployments, then remove it.
DEMS_PURGE_DEMO=false
# Forgot the HOD password? Set the new one in DEMS_SEED_PASSWORD and DEMS_SEED_RESET_PASSWORD=true for ONE deploy, then remove this line.
DEMS_SEED_RESET_PASSWORD=false

INSTITUTION_NAME="Cape Peninsula University of Technology"

# ── Files ─────────────────────────────────────────────────────────────────────
# "db" keeps files in PostgreSQL; "disk" uses a Laravel filesystem disk (DEMS_DISK).
DEMS_STORAGE=db
DEMS_DISK=local
DEMS_MAX_UPLOAD_MB=15

# ── E-mail. MAIL_MAILER=log only writes to storage/logs (the HOD will NOT receive the report). ──
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.edu"
MAIL_FROM_NAME="${APP_NAME}"
