# ── Database (Render injects this automatically via render.yaml) ──────────────
DATABASE_URL="postgresql://dems:dems@localhost:5432/dems?schema=public"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Long random string (>= 32 chars). Generate: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-of-at-least-32-chars"

# Public base URL of the app — used in e-mail links.
APP_URL="http://localhost:3000"

# ── First-run admin (Head of Department) created by `npm run db:seed` ────────
SEED_ADMIN_EMAIL="hod@example.edu"
SEED_ADMIN_PASSWORD="change-me-on-first-login"
SEED_ADMIN_NAME="Head of Department"
# Set to "true" to also create demo users, subjects and an example assessment.
SEED_DEMO_DATA="false"

# ── File storage ──────────────────────────────────────────────────────────────
# "db" (default): files live in PostgreSQL — zero extra infrastructure.
# "s3": AWS S3 (or any S3-compatible service such as Cloudflare R2 / MinIO).
STORAGE_DRIVER="db"
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ENDPOINT=""            # optional, for S3-compatible providers
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ── E-mail (SMTP). If SMTP_HOST is empty, e-mails are logged instead of sent. ─
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
MAIL_FROM="DEMS <no-reply@example.edu>"

# ── Institution branding shown on the PDF report ─────────────────────────────
INSTITUTION_NAME="Your Institution"
