# ── Database ──────────────────────────────────────────────────────────────────
# Supabase: Project Settings → Database → Connection string. URL-encode special characters in the password.
#   DATABASE_URL = "Transaction pooler" string (port 6543) + ?pgbouncer=true&connection_limit=1
#   DIRECT_URL   = "Session pooler" string (port 5432) — used for migrations (works over IPv4, unlike db.<ref>.supabase.co)
DATABASE_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
# Local Postgres (e.g. Laravel Herd Pro): set both to the same URL, e.g.
#   postgresql://root@127.0.0.1:5432/dems?schema=public

# ── Auth ──────────────────────────────────────────────────────────────────────
# Long random string (>= 32 chars). Generate: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-of-at-least-32-chars"

# Public base URL of the app — used in e-mail links.
APP_URL="http://localhost:3000"

# ── First-run admin (Head of Department) created by `npm run db:seed` ────────
SEED_ADMIN_EMAIL="hod@example.edu"
SEED_ADMIN_PASSWORD="change-me-on-first-login"
SEED_ADMIN_NAME="Head of Department"
# Set to "true" to also create demo users, subjects and an example assessment.
SEED_DEMO_DATA="false"

# ── File storage ──────────────────────────────────────────────────────────────
# "db" (default): files live in PostgreSQL — zero extra infrastructure.
# "s3": AWS S3 (or any S3-compatible service such as Cloudflare R2 / MinIO).
STORAGE_DRIVER="db"
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ENDPOINT=""            # optional, for S3-compatible providers
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ── E-mail (SMTP). If SMTP_HOST is empty, e-mails are logged instead of sent. ─
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
MAIL_FROM="DEMS <no-reply@example.edu>"

# ── Institution branding shown on the PDF report ─────────────────────────────
INSTITUTION_NAME="Your Institution"
