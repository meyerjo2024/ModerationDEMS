// Academic Digital Examination & Moderation System (DEMS) — data model.
// Student marks are stored as anonymous numeric scores only (no names / IDs).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EXAMINER
  INTERNAL_MODERATOR
  EXTERNAL_MODERATOR
  HOD
}

enum AssessmentStatus {
  DRAFT
  PENDING_PRE_MODERATION
  REVISION_REQUESTED
  READY_FOR_POST_MODERATION
  PENDING_FINAL_MODERATION
  PENDING_EXTERNAL_MODERATION
  COMPLETED
}

enum ModerationStage {
  PRE_MODERATION
  FINAL_INTERNAL
  FINAL_EXTERNAL
}

enum ModerationDecision {
  APPROVED
  REVISION_REQUESTED
}

enum SignatureSection {
  EXAMINER_SECTION_1
  PRE_MODERATOR
  EXAMINER_SECTION_2
  FINAL_INTERNAL_MODERATOR
  EXTERNAL_MODERATOR
}

enum AttachmentKind {
  PAPER
  MEMO
  MARKS
  SAMPLE_SCRIPT
  FINAL_REPORT
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  department   String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  examinerOf        Assessment[]   @relation("Examiner")
  internalModOf     Assessment[]   @relation("InternalModerator")
  externalModOf     Assessment[]   @relation("ExternalModerator")
  hodOf             Subject[]      @relation("SubjectHod")
  moderationRecords ModerationRecord[]
  signatures        Signature[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  uploads           Attachment[]
}

model Subject {
  id         String       @id @default(cuid())
  code       String       @unique
  name       String
  department String?
  hodId      String
  hod        User         @relation("SubjectHod", fields: [hodId], references: [id])
  assessments Assessment[]
  createdAt  DateTime     @default(now())
}

model Assessment {
  id         String           @id @default(cuid())
  subjectId  String
  subject    Subject          @relation(fields: [subjectId], references: [id])
  /// Assessment number within the subject, e.g. "Test 1", "Exam".
  number     String
  status     AssessmentStatus @default(DRAFT)

  examinerId          String
  examiner            User   @relation("Examiner", fields: [examinerId], references: [id])
  internalModeratorId String
  internalModerator   User   @relation("InternalModerator", fields: [internalModeratorId], references: [id])
  externalModeratorId String?
  externalModerator   User?  @relation("ExternalModerator", fields: [externalModeratorId], references: [id])

  /// Section 1 — [{ type, weighting, heqfLevel, aligned, comment }]
  questionTypes Json?
  /// Number of times Section 1 has been (re)submitted.
  revision      Int     @default(0)

  // Section 2 — post-assessment data harvest (computed server-side).
  totalMarks       Float?
  scores           Json?   // anonymous numeric scores
  candidateCount   Int?
  passCount        Int?
  passRate         Float?  // percentage
  highestMark      Float?  // percentage
  lowestMark       Float?  // percentage
  classAverage     Float?  // percentage
  invalidEntries   Int?
  marksSource      String? // human-readable description of where the marks came from
  examinerCommentary String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  attachments Attachment[]
  records     ModerationRecord[]
  signatures  Signature[]
  auditLogs   AuditLog[]
  notifications Notification[]

  @@unique([subjectId, number])
  @@index([status])
  @@index([examinerId])
  @@index([internalModeratorId])
  @@index([externalModeratorId])
}

model ModerationRecord {
  id           String             @id @default(cuid())
  assessmentId String
  assessment   Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  stage        ModerationStage
  reviewerId   String
  reviewer     User               @relation(fields: [reviewerId], references: [id])
  decision     ModerationDecision
  consensusReached Boolean        @default(false)
  comments     String?
  /// Quality-check answers: [{ id, question, answer: YES|NO|NA, comment }]
  checklist    Json?
  scriptsSampled Int?
  createdAt    DateTime           @default(now())

  @@index([assessmentId])
}

model Signature {
  id           String           @id @default(cuid())
  assessmentId String
  assessment   Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User             @relation(fields: [userId], references: [id])
  section      SignatureSection
  /// PNG data URL of the drawn pen signature.
  imageData    String
  /// SHA-256 of the canonical content the signer attested to.
  contentHash  String
  ipAddress    String?
  userAgent    String?
  signedAt     DateTime         @default(now())

  @@index([assessmentId, section])
}

model AuditLog {
  id           String      @id @default(cuid())
  assessmentId String?
  assessment   Assessment? @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?       @relation(fields: [userId], references: [id])
  action       String
  details      Json?
  ipAddress    String?
  /// Hash chain (per assessment) so after-the-fact edits are detectable.
  prevHash     String?
  hash         String
  createdAt    DateTime    @default(now())

  @@index([assessmentId, createdAt])
}

model Attachment {
  id           String         @id @default(cuid())
  assessmentId String
  assessment   Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  kind         AttachmentKind
  filename     String
  mimeType     String
  size         Int
  sha256       String
  /// Storage driver key: "db:<id>" or "s3:<key>"
  storageKey   String
  uploadedById String
  uploadedBy   User           @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime       @default(now())

  @@index([assessmentId, kind])
}

/// Binary blob store used by the default "db" storage driver.
model FileBlob {
  id   String @id @default(cuid())
  data Bytes
}

model Notification {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessmentId String?
  assessment   Assessment? @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  message      String
  read         Boolean     @default(false)
  createdAt    DateTime    @default(now())

  @@index([userId, read])
}
